# Sviluppo: SQLite. Produzione: postgresql+asyncpg://hesh:PASSWORD@db:5432/hesh
HESH_DATABASE_URL=sqlite+aiosqlite:///./hesh.db

# Dove finiscono gli allegati gia cifrati dal client
HESH_ATTACHMENT_DIR=./attachments
HESH_ATTACHMENT_MAX_MB=50

# Inviti
HESH_INVITE_TTL_HOURS=24

# Coda messaggi: dopo quanti giorni una busta non ritirata viene scartata
HESH_QUEUE_TTL_DAYS=30

# APNs (token-based). Lascia vuoto per disattivare il push in sviluppo.
HESH_APNS_KEY_PATH=
HESH_APNS_KEY_ID=
HESH_APNS_TEAM_ID=
HESH_APNS_TOPIC=it.hesh.app
HESH_APNS_SANDBOX=true
